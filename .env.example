# Copy to .env.local and adjust. That file is gitignored; this one is committed.

# Where the Canva service is listening (see ../canva-backend).
#
# Origin only — the client appends /api/canva/... itself, so a path or a
# trailing slash here produces URLs like //api/canva/login.
#
# Not the same as the backend's CANVA_REDIRECT_URI, which is the full callback
# URL and belongs in canva-backend/.env.
#
# NEXT_PUBLIC_ values are inlined at build time, so restart the dev server
# after changing this.
#
# For local development this is:  http://127.0.0.1:5055
# Optional there, since src/lib/canva.ts already falls back to it. Required
# once the service runs anywhere else.
#
# Left blank deliberately — values in this file get stripped by secret
# scanners, so the example lives in the comment above where it survives.
NEXT_PUBLIC_CANVA_API_URL=

# Where the account service (signup / login) is listening.
#
# Origin *and* base path — the client appends /api/signup and /api/login to it,
# so a service mounted under a prefix needs that prefix here. A trailing slash
# is tolerated.
#
# src/lib/auth.ts falls back to the deployed service, so this is only needed to
# point the editor somewhere else — a local backend, for instance, which is
# http://localhost:5002
#
# Left blank deliberately — see the note above about secret scanners.
NEXT_PUBLIC_AUTH_API_URL=

# Where the image service (background removal) is listening.
#
# Origin *and* base path, like the account service — the client appends
# /api/images/... to it. In production both live on the same backend, and
# src/lib/image-service.ts falls back to it, so this is only needed to point
# the editor at a different one.
#
# Left blank deliberately — see the note above about secret scanners.
NEXT_PUBLIC_IMAGE_API_URL=

# Stylesheet that serves the interface typeface, Aktiv Grotesk.
#
# An Adobe Fonts kit: https://use.typekit.net/<kit-id>.css — created at
# fonts.adobe.com, with this app's domains added to the kit. The family is
# licensed per domain, so the faces cannot be committed to the repo.
#
# Unset, the interface falls back to the platform's own grotesk and nothing
# else changes. The storefront embed renders no <head>, so there the app-proxy
# page passes the same URL as `window.__FONT_KIT_URL__` instead.
NEXT_PUBLIC_FONT_KIT_URL=