# Copy to .env.local and adjust. That file is gitignored; this one is committed.

# Where the Canva service is listening (see ../canva-backend).
#
# Origin only — the client appends /api/canva/... itself, so a path or a
# trailing slash here produces URLs like //api/canva/login.
#
# Not the same as the backend's CANVA_REDIRECT_URI, which is the full callback
# URL and belongs in canva-backend/.env.
#
# NEXT_PUBLIC_ values are inlined at build time, so restart the dev server
# after changing this.
#
# Optional locally: src/lib/canva.ts already falls back to this exact value.
NEXT_PUBLIC_CANVA_API_URL=
